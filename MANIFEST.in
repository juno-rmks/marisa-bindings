# Project license
include LICENSE

# Vendoring metadata
include third_party/marisa-trie/VENDORING.md

# Upstream license / attribution (optional but recommended)
include third_party/marisa-trie/upstream/AUTHORS
include third_party/marisa-trie/upstream/COPYING.md

# Headers & sources required to build the extension from sdist
recursive-include third_party/marisa-trie/upstream/include *.h
recursive-include third_party/marisa-trie/upstream/lib *.h *.cc

# SWIG interface & companion sources used by setup.py
include bindings/marisa-swig.i
include bindings/marisa-swig.h
include bindings/marisa-swig.cxx
include bindings/marisa-swig_wrap.cxx
